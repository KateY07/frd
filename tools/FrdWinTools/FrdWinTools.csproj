<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>frd-wintools</AssemblyName>
    <RootNamespace>Frd</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Authors>KateY07</Authors>
    <Copyright>Copyright (c) 2026 KateY07</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>4.0.0-pre3</Version>
    <InformationalVersion>v4.pre3</InformationalVersion>
    <PublishAot Condition="'$(PublishAot)' == ''">true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <!-- Shared with FRD.exe: wire format, key/shared-memory helpers and the input injector. -->
    <Compile Include="..\..\src\Secure\SecureShared.cs" Link="Shared\FfmpegSecureShared.cs" />
    <Compile Include="..\..\src\Secure\SecureDesktop.cs" Link="Shared\FfmpegSecureDesktop.cs" />
    <Compile Include="..\..\src\Secure\SecureInput.cs" Link="Shared\FfmpegSecureInput.cs" />
    <Compile Include="..\..\src\Channels\InputInjector.cs" Link="Shared\FfmpegInputInjector.cs" />
  </ItemGroup>
</Project>
