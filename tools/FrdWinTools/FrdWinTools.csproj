<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>frd-wintools</AssemblyName>
    <RootNamespace>Frd</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>3.0.0-pre1</Version>
    <InformationalVersion>v3.pre1</InformationalVersion>
    <PublishAot Condition="'$(PublishAot)' == ''">true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <!-- Shared with FRD.exe: wire format, key/shared-memory helpers and the input injector. -->
    <Compile Include="..\..\FfmpegSecureShared.cs" Link="Shared\FfmpegSecureShared.cs" />
    <Compile Include="..\..\FfmpegSecureDesktop.cs" Link="Shared\FfmpegSecureDesktop.cs" />
    <Compile Include="..\..\FfmpegSecureInput.cs" Link="Shared\FfmpegSecureInput.cs" />
    <Compile Include="..\..\FfmpegInputInjector.cs" Link="Shared\FfmpegInputInjector.cs" />
  </ItemGroup>
</Project>
