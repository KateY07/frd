<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <StartupObject>Frd.Program</StartupObject>
    <Version>2.0.0-pre15</Version>
    <InformationalVersion>v2.pre15</InformationalVersion>
    <SelfContained>false</SelfContained>
    <PublishAot>false</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MouseFollowDual" />
    <InternalsVisibleTo Include="PathSwitchResilience" />
    <PackageReference Include="FFmpeg.AutoGen" Version="8.0.0" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="12.1.1" />
    <Compile Include="Ffmpeg*.cs" />
    <Content Include="codec-config.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Only the libraries FRD actually calls (avcodec, avutil, swscale) plus avcodec own dependency swresample. -->
    <FfmpegRuntimeFile Include="third_party\ffmpeg\runtime\avcodec-62.dll;third_party\ffmpeg\runtime\avutil-60.dll;third_party\ffmpeg\runtime\swscale-9.dll;third_party\ffmpeg\runtime\swresample-6.dll;third_party\ffmpeg\runtime\LICENSE.txt" />
    <Content Include="@(FfmpegRuntimeFile)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" TargetPath="ffmpeg\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
