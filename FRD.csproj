<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Do not copy the referenced library's XML documentation file next to the exe. -->
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
    <Authors>KateY07</Authors>
    <Copyright>Copyright (c) 2026 KateY07</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/KateY07/frd</PackageProjectUrl>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <StartupObject>Frd.Program</StartupObject>
    <Version>5.0.0</Version>
    <InformationalVersion>v5.0</InformationalVersion>
    <!-- NativeAOT: one native exe, no .NET runtime to install. JSON stays reflection-based (rooted below), reports use anonymous types. -->
    <PublishAot Condition="'$(PublishAot)' == ''">true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <IlcGenerateStackTraceData>true</IlcGenerateStackTraceData>
    <NoWarn>$(NoWarn);IL2026;IL3050;IL2067;IL2070;IL2072;IL2075;IL2087;IL2091</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="external\Glasspane\src\Glasspane\Glasspane.csproj" />
    <Using Include="Glasspane" />
    <TrimmerRootAssembly Include="FRD" />
    <InternalsVisibleTo Include="MouseFollowDual" />
    <InternalsVisibleTo Include="PathSwitchResilience" />
    <PackageReference Include="FFmpeg.AutoGen" Version="8.0.0" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
    <Compile Include="src/**/*.cs" />
    <Content Include="codec-config.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Only the libraries FRD actually calls (avcodec, avutil, swscale) plus avcodec own dependency swresample. -->
    <FfmpegRuntimeFile Condition="'$(IncludeFfmpegRuntime)' != 'false'" Include="third_party\ffmpeg\runtime\avcodec-62.dll;third_party\ffmpeg\runtime\avutil-60.dll;third_party\ffmpeg\runtime\swscale-9.dll;third_party\ffmpeg\runtime\swresample-6.dll;third_party\ffmpeg\runtime\LICENSE.txt" />
    <Content Include="@(FfmpegRuntimeFile)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" TargetPath="ffmpeg\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
